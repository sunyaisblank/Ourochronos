# Source-level declaration of an input-indexed Deutschian CTC family.
# POLY c d a means c*n^d + a. These are explicit proof obligations, not
# assertions the finite runtime can establish merely by executing one input.

FAMILY identity_family {
    CTC_CELLS POLY 2 1 1;
    # Conservative concrete verifier budget for input, Boolean decision,
    # operand/control workspace, and any dynamic state.
    CHRONOLOGY_BITS POLY 256 1 64;
    TRANSITION_STEPS POLY 16 2 16;
    UNIFORM;
    TOTAL;
    READOUT_INVARIANT;
    IDEAL_DEUTSCH;
    EFFECTS_FROZEN;
}

# Identity transition has two one-bit recurrent classes. Both deliberately
# produce the same Boolean decision, so all stationary mixtures agree.
0 ORACLE DUP 0 PROPHECY POP 1 OUTPUT
